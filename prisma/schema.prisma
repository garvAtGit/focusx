generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String             @id @default(uuid())
  authId                      String?            @unique
  role                        Role               @default(STUDENT)
  email                       String?            @unique
  name                        String
  phone                       String?            @unique
  area                        String?
  uniqueId                    String?            @unique
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  password                    String?
  address                     String?
  dob                         DateTime?
  gender                      String?
  profilePhotoUrl             String?
  locality                    String?
  organization                String?
  qualification               String?
  digilockerVerified          Boolean            @default(false)
  employerLibraryId           String?
  consecutiveFailures         Int                @default(0)
  failureReasons              String?
  rfidTag                     String?            @unique
  kycAadhaarDob               DateTime?
  kycAadhaarDocumentConsent   String?
  kycAadhaarDocumentRequested String?
  kycAadhaarGender            String?
  kycAadhaarMobile            String?
  kycAadhaarName              String?
  kycAadhaarProfilePhotoUrl   String?
  kycAadhaarReferenceId       String?
  kycAadhaarStatus            String?
  kycAadhaarVerificationId    String?
  kycEAadhaar                 String?
  crmNote                     String?
  isExpiredLead               Boolean            @default(false)
  referralCode                String?            @unique
  referredById                String?
  walletBalance               Int                @default(0)
  currentStreak               Int                @default(0)
  lastActiveDate              DateTime?
  adminPermissions            String[]           @default([])
  winterArcEnrollment         WinterArcEnrollment?
  bookings                    Booking[]
  bookingIntents              BookingIntent[]
  canvasState                 CanvasState?
  checkins                    CheckinLog[]       @relation("StudentCheckins")
  entryLogs                   EntryLog[]
  libraries                   Library[]          @relation("LibrarianLibraries")
  notifications               Notification[]
  sentBroadcasts              NotificationBroadcast[] @relation("SentBroadcasts")
  platformFeedbacks           PlatformFeedback[] @relation("SubmitterPlatformFeedback")
  queries                     Query[]
  employerLibrary             Library?           @relation("LibraryStaff", fields: [employerLibraryId], references: [id])
  referredBy                  User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers               User[]             @relation("UserReferrals")
  pushSubscriptions           PushSubscription[]
  browserPushEnabled          Boolean            @default(true)
  pushDeliveries              PushDeliveryQueue[]
  staffMemberships            LibraryStaff[]     @relation("UserStaffMemberships")
  grantedStaff                LibraryStaff[]     @relation("StaffGrants")
  staffAuditLogs              StaffAuditLog[]    @relation("StaffAuditActor")

  @@index([name])
  @@index([phone])
  @@index([role])
}

model Library {
  authRevision Int @default(0)
  id                String             @id @default(uuid())
  librarianId       String
  name              String
  managerName       String?
  managerPhone      String?
  address           String
  metroStation      String?
  googleMapsUrl     String?
  facilities        String[]
  paymentAccountId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  city              String?
  closingTime       String?
  description       String?
  district          String?
  locality          String?
  metroDistance     Float?
  openingTime       String?
  photos            String[]
  pinCode           String?
  seatsAvailable    Int?
  state             String?
  whatsapp          String?
  kycStatus         KycStatus          @default(PENDING)
  passbookPhoto     String?
  compactSeatMap    Boolean            @default(false)
  seatNaming        SeatNaming         @default(ALPHANUMERIC)
  adminNotes        String?
  wifiSsid          String?
  wifiPassword      String?
  bookings          Booking[]
  bookingIntents    BookingIntent[]
  checkinLogs       CheckinLog[]
  entryLogs         EntryLog[]
  expenses          Expense[]
  inquiries         Inquiry[]
  librarian         User               @relation("LibrarianLibraries", fields: [librarianId], references: [id])
  plans             Plan[]
  queries           Query[]
  relays            Relay[]
  rules             LibraryRule[]
  seats             Seat[]
  standaloneLockers StandaloneLocker[]
  staff             User[]             @relation("LibraryStaff")
  staffMemberships  LibraryStaff[]     @relation("LibraryStaffMemberships")

  @@index([librarianId])
  @@index([kycStatus])
}

model Seat {
  id                String          @id @default(uuid())
  libraryId         String
  name              String
  type              SeatType        @default(NORMAL)
  gridX             Int
  gridY             Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  hasLocker         Boolean         @default(false)
  syncPremiumOffers Boolean         @default(true)
  lockerPriceDaily  Float?
  premiumPriceDaily Float?
  bookings          Booking[]
  bookingIntents    BookingIntent[]
  library           Library         @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
}

model Plan {
  id             String          @id @default(uuid())
  libraryId      String
  name           String
  type           PlanType
  durationHours  Int?
  validityDays   Int
  price          Float
  discount       Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isActive       Boolean         @default(true)
  bookings       Booking[]
  bookingIntents BookingIntent[]
  library        Library         @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
}

model StandaloneLocker {
  id             String          @id @default(uuid())
  libraryId      String
  name           String
  price          Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  bookingIntents BookingIntent[]
  library        Library         @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
}

model Booking {
  id                    String            @id @default(uuid())
  studentId             String
  libraryId             String
  seatId                String?
  planId                String
  startTime             DateTime
  endTime               DateTime
  status                BookingStatus     @default(PENDING_PAYMENT)
  paymentRef            String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  hasLocker             Boolean           @default(false)
  standaloneLockerId    String?
  isPaused              Boolean           @default(false)
  pausedAt              DateTime?
  resumedAt             DateTime?
  totalPausedDays       Int               @default(0)
  revokedReason         String?
  amountDuePaise        Int?
  amountPaidCashPaise   Int?
  amountPaidOnlinePaise Int?
  library               Library           @relation(fields: [libraryId], references: [id])
  plan                  Plan              @relation(fields: [planId], references: [id])
  seat                  Seat?             @relation(fields: [seatId], references: [id])
  standaloneLocker      StandaloneLocker? @relation(fields: [standaloneLockerId], references: [id])
  student               User              @relation(fields: [studentId], references: [id])
  bookingIntent         BookingIntent?
  refundTasks           RefundTask[]

  @@index([libraryId, status])
  @@index([libraryId, status, endTime])
  @@index([libraryId, studentId])
  @@index([libraryId, studentId, createdAt])
  @@index([libraryId, startTime])
  @@index([libraryId, status, isPaused])
  @@index([studentId])
  @@index([studentId, status])
  @@index([seatId])
  @@index([standaloneLockerId])
  @@index([endTime])
}

model BookingIntent {
  providerOrderId     String?             @unique
  id                  String              @id @default(uuid())
  referenceId         String              @unique
  idempotencyKey      String?             @unique
  source              BookingIntentSource
  status              BookingIntentStatus @default(HOLDING)
  studentId           String
  libraryId           String
  planId              String
  seatId              String?
  standaloneLockerId  String?
  hasLocker           Boolean             @default(false)
  expectedAmountPaise Int
  currency            String              @default("INR")
  startsAt            DateTime
  endsAt              DateTime
  holdExpiresAt       DateTime?
  providerLinkId      String?             @unique
  providerShortUrl    String?
  providerPaymentId   String?             @unique
  providerPaidAt      DateTime?
  bookingId           String?             @unique
  failureReason       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  booking             Booking?            @relation(fields: [bookingId], references: [id])
  library             Library             @relation(fields: [libraryId], references: [id])
  plan                Plan                @relation(fields: [planId], references: [id])
  seat                Seat?               @relation(fields: [seatId], references: [id])
  standaloneLocker    StandaloneLocker?   @relation(fields: [standaloneLockerId], references: [id])
  student             User                @relation(fields: [studentId], references: [id])
  refundTasks         RefundTask[]
  leases              ResourceLease[]

  @@index([libraryId, status])
  @@index([studentId, createdAt])
  @@index([holdExpiresAt])
}

model ResourceLease {
  resourceType LeaseResourceType
  resourceId   String
  intentId     String
  libraryId    String
  studentId    String
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  intent       BookingIntent     @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@id([resourceType, resourceId])
  @@index([intentId])
  @@index([libraryId, expiresAt])
}

model RefundTask {
  id               String           @id @default(uuid())
  paymentId        String           @unique
  amountPaise      Int
  currency         String           @default("INR")
  reason           String
  status           RefundTaskStatus @default(PENDING)
  attempts         Int              @default(0)
  nextAttemptAt    DateTime         @default(now())
  lockedAt         DateTime?
  lastError        String?
  providerRefundId String?          @unique
  completedAt      DateTime?
  intentId         String?
  bookingId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  booking          Booking?         @relation(fields: [bookingId], references: [id])
  intent           BookingIntent?   @relation(fields: [intentId], references: [id])

  @@index([status, nextAttemptAt])
}

model ProcessedWebhookEvent {
  id          String   @id
  eventType   String
  payloadHash String
  processedAt DateTime @default(now())
}

model Query {
  id        String    @id @default(uuid())
  type      QueryType
  content   String
  rating    Int?
  studentId String
  libraryId String
  createdAt DateTime  @default(now())
  library   Library   @relation(fields: [libraryId], references: [id])
  student   User      @relation(fields: [studentId], references: [id])

  @@index([libraryId])
  @@index([studentId])
}

model Relay {
  id          String       @id @default(uuid())
  libraryId   String
  macAddress  String?
  nfcTagId    String       @unique
  bleReaderId String?      @unique
  deviceSecret String?     @unique @default(uuid())
  status      String       @default("ONLINE")
  lastSync    DateTime     @default(now())
  lastSeenAt  DateTime?
  pendingCommand String?
  clockState  String?
  freeFlashBytes Int?
  pendingEventsCount Int?
  currentAuthRevision Int?
  firmwareVersion     String?
  lastScreenLine0     String?
  lastScreenLine1     String?
  lastScreenBacklight Int?         @default(1)
  lastScreenUpdatedAt DateTime?
  diagQueueDepth      Int?         @default(0)
  diagDroppedCount    Int?         @default(0)
  lastDiagAckAt       DateTime?
  resetReason         String?
  liveDebugUntil      DateTime?
  diagnosticLogs      DeviceDiagnosticLog[]
  screenHistory       DeviceScreenHistory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  logs        CheckinLog[]
  deviceRollouts OtaDeviceRollout[]
  library     Library      @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
}

model DeviceDiagnosticLog {
  id               String   @id @default(uuid())
  relayId          String
  eventId          String   @unique
  eventCode        Int
  severity         String
  timestamp        DateTime
  uptimeMs         BigInt
  param1           Int?
  param2           BigInt?
  detail           String?
  serverReceivedAt DateTime @default(now())
  relay            Relay    @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@index([relayId, timestamp])
  @@index([severity, timestamp])
  @@index([eventCode])
}

model DeviceScreenHistory {
  id        String   @id @default(uuid())
  relayId   String
  line0     String
  line1     String
  backlight Int      @default(1)
  trigger   String?
  timestamp DateTime @default(now())
  relay     Relay    @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@index([relayId, timestamp])
}

model CheckinLog {
  realtimeOutbox RealtimeOutbox?
  id             String          @id @default(uuid())
  studentId      String
  libraryId      String
  relayId        String?
  eventId        String?         @unique
  status         CheckinStatus
  timestamp      DateTime        @default(now())
  isOfflineSync  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  library        Library         @relation(fields: [libraryId], references: [id])
  relay          Relay?          @relation(fields: [relayId], references: [id])
  student        User            @relation("StudentCheckins", fields: [studentId], references: [id])

  @@index([libraryId, timestamp])
  @@index([studentId, libraryId])
}

model PlatformFeedback {
  id           String   @id @default(uuid())
  targetType   String
  libraryId    String?
  submitterId  String
  studentName  String?
  studentPhone String?
  content      String
  createdAt    DateTime @default(now())
  submitter    User     @relation("SubmitterPlatformFeedback", fields: [submitterId], references: [id])

  @@index([targetType])
  @@index([submitterId])
}

model Expense {
  id        String   @id @default(uuid())
  libraryId String
  name      String
  amount    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  library   Library  @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
}

model Inquiry {
  id        String        @id @default(uuid())
  libraryId String
  name      String
  phone     String
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  library   Library       @relation(fields: [libraryId], references: [id])

  @@index([libraryId])
  @@index([status])
}

model EntryLog {
  id        String   @id @default(uuid())
  userId    String?
  libraryId String
  doorId    String?
  timestamp DateTime
  eventId   String?  @unique
  createdAt DateTime @default(now())
  reason    String?
  status    String   @default("SUCCESS")
  library   Library  @relation(fields: [libraryId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([libraryId])
  @@index([libraryId, timestamp])
  @@index([timestamp])
}

model Notification {
  id          String                 @id @default(uuid())
  studentId   String
  userId      String?
  broadcastId String?
  eventId     String?                @unique
  title       String
  message     String
  isRead      Boolean                @default(false)
  readAt      DateTime?
  createdAt   DateTime               @default(now())
  actionLabel String?
  actionUrl   String?
  type        String?                @default("INFO")
  student     User                   @relation(fields: [studentId], references: [id])
  broadcast   NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  pushDeliveries PushDeliveryQueue[]

  @@index([studentId])
  @@index([studentId, isRead])
  @@index([studentId, createdAt])
  @@index([userId])
  @@index([broadcastId])
}

model NotificationBroadcast {
  id                   String          @id @default(uuid())
  senderId             String
  title                String
  message              String
  type                 String          @default("INFO")
  actionLabel          String?
  actionUrl            String?
  audienceType         String
  targetLibraryIds     String[]        @default([])
  idempotencyKey       String?         @unique
  payloadHash          String?
  totalTargets         Int             @default(0)
  sentCount            Int             @default(0)
  failedCount          Int             @default(0)
  status               String          @default("PENDING")
  errorMessage         String?
  scheduledFor         DateTime?
  manifestRecipientIds String[]        @default([])
  isCancelled          Boolean         @default(false)
  claimedAt            DateTime?
  claimedBy            String?
  leaseToken           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  sender               User            @relation("SentBroadcasts", fields: [senderId], references: [id])
  notifications        Notification[]

  @@index([senderId])
  @@index([status])
  @@index([createdAt])
  @@index([status, scheduledFor])
  @@index([status, isCancelled, scheduledFor])
}

model CanvasState {
  id        String   @id @default(uuid())
  userId    String   @unique
  widgets   Json     @default("[]")
  theme     String   @default("pastel-pink")
  font      String   @default("inter")
  bgUrl     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workflow Automation — LibraryRule + RuleExecution
// ---------------------------------------------------------------------------

model LibraryRule {
  id                String             @id @default(uuid())
  libraryId         String
  name              String
  isActive          Boolean            @default(true)
  trigger           RuleTrigger
  conditionField    RuleConditionField
  conditionOperator RuleOperator
  conditionValue    Float
  action            RuleAction
  actionMessage     String? // Optional template with {name}, {overstay_hours} etc.
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  library           Library            @relation(fields: [libraryId], references: [id])
  executions        RuleExecution[]

  @@index([libraryId])
  @@index([libraryId, isActive, trigger])
}

model RuleExecution {
  id           String              @id @default(uuid())
  ruleId       String
  libraryId    String
  studentId    String
  trigger      RuleTrigger
  action       RuleAction
  status       RuleExecutionStatus @default(SUCCESS)
  errorMessage String?
  executedAt   DateTime            @default(now())
  rule         LibraryRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([libraryId, executedAt])
  @@index([studentId, executedAt])
  @@index([ruleId, studentId, executedAt]) // for cooldown checks
}

enum Role {
  STUDENT
  LIBRARIAN
  ADMIN
  RECEPTIONIST
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeatType {
  RESERVED
  NORMAL
  NON_RESERVABLE
  PREMIUM
}

enum SeatNaming {
  ALPHANUMERIC
  NUMERIC
}

enum PlanType {
  FIXED
  FLEXIBLE
}

enum PlanSeatCategory {
  GENERAL
  PREMIUM
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingIntentSource {
  RAZORPAY
  RECEPTION
  MANUAL
  HARDWARE
  RENEWAL
}

enum BookingIntentStatus {
  HOLDING
  AWAITING_PAYMENT
  AWAITING_MANUAL_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum LeaseResourceType {
  SEAT
  STANDALONE_LOCKER
}

enum RefundTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueryType {
  FEEDBACK
  COMPLAINT
  REVIEW
}

enum CheckinStatus {
  CHECK_IN
  CHECK_OUT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum RuleTrigger {
  OVERSTAY
  BOOKING_EXPIRING
  ABSENT
  PAYMENT_DUE
  CHECKIN
  CHECKOUT
  BOOKING_CREATED
}

enum RuleConditionField {
  overstay_hours
  days_left
  absence_days
  amount_due
  session_count
}

enum RuleOperator {
  gt
  lt
  gte
  lte
  eq
}

enum RuleAction {
  NOTIFY_STUDENT
  NOTIFY_LIBRARIAN
  REVOKE_BOOKING
  ADD_CRM_NOTE
  FLAG_FOR_REVIEW
  MARK_EXPIRED_LEAD
}

enum RuleExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model RealtimeOutbox {
  id            String      @id @default(uuid())
  eventId       String      @unique
  topic         String?
  type          String      @default("REALTIME")
  payload       Json
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  checkinLogId  String?     @unique
  checkinLog    CheckinLog? @relation(fields: [checkinLogId], references: [id])
  studentId     String?
  isPublished   Boolean     @default(false)
  attempts      Int         @default(0)
  maxAttempts   Int         @default(5)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockedBy      String?
  leaseToken    String?
  lastError     String?

  @@index([status, isPublished, nextAttemptAt, lockedAt])
  @@index([topic])
}

model HardwareClaim {
  id          String   @id @default(uuid())
  claimCode   String   @unique
  macAddress  String
  bleReaderId String?
  nfcTagId    String?
  isClaimed   Boolean  @default(false)
  libraryId   String? // Once claimed, store which library took it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WinterArcEnrollment {
  id            String   @id @default(uuid())
  studentId     String   @unique
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leagueHours   Int
  targetHours   Int
  discount      Int
  createdAt     DateTime @default(now())
}



model OtaRollout {
  id              String             @id @default(uuid())
  name            String
  targetVersion   String
  targetSha256    String
  targetSize      Int
  status          String             @default("ACTIVE")
  totalBatches    Int                @default(1)
  currentBatch    Int                @default(1)
  batchConfig     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdById     String?
  deviceRollouts  OtaDeviceRollout[]

  @@index([status])
  @@index([targetVersion])
}

model OtaDeviceRollout {
  id              String       @id @default(uuid())
  rolloutId       String
  relayId         String
  batchIndex      Int          @default(1)
  cmdId           String?
  status          String       @default("NOT_STARTED")
  initialVersion  String?
  targetVersion   String
  attempts        Int          @default(0)
  lastError       String?
  dispatchedAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  rollout         OtaRollout   @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  relay           Relay        @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@unique([rolloutId, relayId])
  @@index([relayId])
  @@index([status])
  @@index([cmdId])
  @@index([rolloutId, batchIndex])
}

model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  isActive      Boolean   @default(true)
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([endpoint])
}

model PushDeliveryQueue {
  id             String        @id @default(uuid())
  notificationId String
  userId         String
  subscriptionId String?
  endpoint       String
  p256dh         String
  auth           String
  payload        Json
  status         String        @default("PENDING") // PENDING, PROCESSING, SENT, FAILED, PERMANENT_FAILURE
  attempts       Int           @default(0)
  maxAttempts    Int           @default(5)
  nextAttemptAt  DateTime?
  lastError      String?
  claimedAt      DateTime?
  claimedBy      String?
  leaseToken     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, claimedAt])
  @@index([userId])
  @@index([notificationId])
  @@index([endpoint])
}

enum StaffRole {
  MANAGER
  RECEPTIONIST
  CUSTOM
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

model LibraryStaff {
  id             String         @id @default(uuid())
  userId         String
  libraryId      String
  role           StaffRole      @default(RECEPTIONIST)
  customRoleName String?
  status         StaffStatus    @default(ACTIVE)
  permissions    String[]
  grantedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation("UserStaffMemberships", fields: [userId], references: [id], onDelete: Cascade)
  library        Library        @relation("LibraryStaffMemberships", fields: [libraryId], references: [id], onDelete: Cascade)
  grantedBy      User?          @relation("StaffGrants", fields: [grantedById], references: [id], onDelete: SetNull)
  auditLogs      StaffAuditLog[]

  @@unique([userId, libraryId])
  @@index([userId])
  @@index([libraryId])
  @@index([status])
}

model StaffAuditLog {
  id             String       @id @default(uuid())
  libraryStaffId String
  actorId        String?
  action         String       // "CREATED", "PERMISSIONS_UPDATED", "ROLE_UPDATED", "STATUS_UPDATED", "REVOKED"
  previousRole   StaffRole?
  newRole        StaffRole?
  previousStatus StaffStatus?
  newStatus      StaffStatus?
  previousPerms  String[]
  newPerms       String[]
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  libraryStaff   LibraryStaff @relation(fields: [libraryStaffId], references: [id], onDelete: Cascade)
  actor          User?        @relation("StaffAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([libraryStaffId])
  @@index([actorId])
  @@index([createdAt])
}


